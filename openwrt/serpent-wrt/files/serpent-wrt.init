#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=5

# IPKG_INSTROOT supports image-root checks and local harnesses; empty on a device.
ROOT="${IPKG_INSTROOT:-}"
PROG="$ROOT/usr/sbin/serpent-wrt"
CONF="$ROOT/etc/serpent-wrt/serpent-wrt.yaml"
FEED="$ROOT/etc/serpent-wrt/threat-feed.txt"

extra_command "configtest" "Validate configuration, feed, and fw4 prerequisites"
extra_command "nftcheck" "Validate nftables enforcement resources"
extra_command "reload_feed" "Reload threat feed without restarting"

configtest() {
	"$PROG" --config "$CONF" configtest
}

nftcheck() {
	"$PROG" --config "$CONF" nftcheck
}

start_service() {
	# Read-only validation. Never start or reconcile the drop policy here:
	# the daemon creates the sets and then reconciles enabled policy.
	configtest || return 1

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONF" "$FEED"
	procd_close_instance
}

stop_service() {
	# Uses the persisted table/set identity, never the current configuration,
	# so a bad config edit cannot prevent removal of the owned chain.
	if [ ! -x "$PROG" ]; then
		echo "serpent-wrt: cannot remove the owned packet-drop chain: $PROG is unavailable" >&2
		return 1
	fi
	if ! "$PROG" firewall disable; then
		echo "serpent-wrt: failed to remove the owned packet-drop chain" >&2
		return 1
	fi
	return 0
}

restart() {
	# Validate before stop so an invalid drop configuration leaves the current
	# daemon and its policy intact.
	configtest || return 1

	trap '' TERM
	if ! stop "$@"; then
		trap - TERM
		return 1
	fi
	trap - TERM
	start "$@"
}

reload_service() {
	reload_feed
}

reload_feed() {
	configtest || return 1
	procd_send_signal serpent-wrt "*" HUP
}
