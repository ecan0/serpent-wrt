<!-- serpent-wrt rules
     Rule ID range: 100200–100299

     Hierarchy:
       100200  base catch-all (level 3) — any serpent-wrt event
       100201  detection event (level 10)
         100202  feed_match   (level 12) — known-bad IP contact
         100203  port_scan    (level 10) — recon
         100204  fanout       (level 10) — connection spread
         100205  beacon       (level 10) — C2 periodic pattern
         100206  ext_scan     (level 10) — external scan
         100207  brute_force  (level 10) — repeated authentication attempts
       100210  enforcement event (level 10) — IP blocked by nftables
-->

<group name="serpent-wrt,network,threat-detection,">

  <!-- Base rule: any event from serpent-wrt.
       Matches the parent decoder name ('serpent-wrt') — JSON fields are
       decoded by the child JSON_Decoder plugin but the active decoder
       name reported to rules is the parent. -->
  <rule id="100200" level="3">
    <decoded_as>serpent-wrt</decoded_as>
    <description>serpent-wrt: event received</description>
    <group>serpent-wrt,</group>
  </rule>

  <!-- Detection event — a behavioral detector fired -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="type">^detection$</field>
    <description>serpent-wrt: $(detector) detection — src $(src_ip)</description>
    <group>serpent-wrt,detection,</group>
  </rule>

  <!-- Threat feed match: outbound connection to a known-bad IP -->
  <rule id="100202" level="12">
    <if_sid>100201</if_sid>
    <field name="detector">^feed_match$</field>
    <description>serpent-wrt: threat feed match — $(src_ip) contacted known-bad $(dst_ip)</description>
    <group>serpent-wrt,feed_match,threat,</group>
  </rule>

  <!-- Port scan: one source probing many ports on one target -->
  <rule id="100203" level="10">
    <if_sid>100201</if_sid>
    <field name="detector">^port_scan$</field>
    <description>serpent-wrt: port scan detected from $(src_ip)</description>
    <group>serpent-wrt,port_scan,recon,</group>
  </rule>

  <!-- Fanout: one source connecting to many distinct destinations -->
  <rule id="100204" level="10">
    <if_sid>100201</if_sid>
    <field name="detector">^fanout$</field>
    <description>serpent-wrt: outbound fanout detected from $(src_ip)</description>
    <group>serpent-wrt,fanout,recon,</group>
  </rule>

  <!-- Beaconing: periodic connections at a consistent interval (C2 pattern) -->
  <rule id="100205" level="10">
    <if_sid>100201</if_sid>
    <field name="detector">^beacon$</field>
    <description>serpent-wrt: C2 beaconing pattern detected from $(src_ip) to $(dst_ip)</description>
    <group>serpent-wrt,beacon,c2,</group>
  </rule>

  <!-- External scan: one source scans services across external targets -->
  <rule id="100206" level="10">
    <if_sid>100201</if_sid>
    <field name="detector">^ext_scan$</field>
    <description>serpent-wrt: external scan detected from $(src_ip)</description>
    <group>serpent-wrt,ext_scan,recon,</group>
  </rule>

  <!-- Brute force: repeated authentication attempts against one service -->
  <rule id="100207" level="10">
    <if_sid>100201</if_sid>
    <field name="detector">^brute_force$</field>
    <description>serpent-wrt: brute force detected from $(src_ip) to $(dst_ip)</description>
    <group>serpent-wrt,brute_force,authentication,</group>
  </rule>

  <!-- Enforcement: nftables block applied to a source IP -->
  <rule id="100210" level="10">
    <if_sid>100200</if_sid>
    <field name="type">^enforcement$</field>
    <description>serpent-wrt: $(src_ip) blocked by nftables</description>
    <group>serpent-wrt,enforcement,blocked,</group>
  </rule>

</group>
